<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Glimpse</RootNamespace>
    <AssemblyName>Glimpse</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 主副屏分辨率与缩放常不一致，必须按显示器各自 DPI 处理 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glimpse.Abstractions\Glimpse.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 采集与呈现所需的 GPU 绑定 -->
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
    <PackageReference Include="Vortice.DirectComposition" />
    <!-- 运行时编译全屏三角形着色器，避免把预编译字节码塞进仓库 -->
    <PackageReference Include="Vortice.D3DCompiler" />
  </ItemGroup>

  <ItemGroup>
    <!-- 纯函数测试需要访问内部实现，测试工程本身仍不触碰 GPU -->
    <InternalsVisibleTo Include="Glimpse.Tests" />
  </ItemGroup>

</Project>
